# Cloudflare Pages headers
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Fingerprint-free assets: revalidate daily, serve stale while revalidating.
/assets/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/css/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/js/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# HTML should always be revalidated so content edits go live immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# The blog editor is private. Cloudflare Access gates it, and the Function
# behind it sets these too; this covers the static shell as well.
/admin
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/admin/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
